PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Must include replicaSet=rs0. Matches the local Mongo in docker-compose.yaml.
MONGO_URI=mongodb://admin:password123@127.0.0.1:27017/demo_db?authSource=admin&replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Leave SMTP_HOST empty to print credential emails in the API log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DocFlow <no-reply@docflow.local>

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=audio
AUDIO_MAX_BYTES=10485760

WHISPER_ASR_URL=http://127.0.0.1:9002/asr
